# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=all-minilm:33m

ORCHESTRATOR_LLM_MODEL=functiongemma:270m

##WRITER_LLM_MODEL=qwen2:1.5b
#SELECTOR_LLM_MODEL=alibayram/hunyuan:0.5b
#SELECTOR_LLM_MODEL=granite4:350m
SELECTOR_LLM_MODEL=nemotron-3-nano:30b-cloud

#WRITER_LLM_MODEL=qwen2:1.5b
#WRITER_LLM_MODEL=alibayram/hunyuan:0.5b
#WRITER_LLM_MODEL=granite4:350m
WRITER_LLM_MODEL=nemotron-3-nano:30b-cloud

# Database Configuration
DATABASE_PATH=db.sqlite

# Orchestrator Agent Configuration
ORCHESTRATOR_MAX_CONTEXT_LENGTH=512
ORCHESTRATOR_TEMPERATURE=0.7
ORCHESTRATOR_MAX_TOKENS=512

# Selector Agent Configuration
SELECTOR_TEMPERATURE=0.0
SELECTOR_MAX_TOKENS=64
SELECTOR_REASONING=false
SELECTOR_NUM_CTX=1024

# Writer Agent Configuration
WRITER_TEMPERATURE=0.9
WRITER_MAX_TOKENS=1024
WRITER_REASONING=false
WRITER_NUM_CTX=1024

# Vector Search Configuration
WIRES_VECTOR_SEARCH_TOP_K=15
WIRES_VECTOR_SEARCH_THRESHOLD=0.3
VECTOR_SEARCH_VECTOR_K = 384
